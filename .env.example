# =========================================================================
# MAZHI SHETI (माझी शेती) PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for development or configure directly in deployment manager
# =========================================================================

# Application Info
NEXT_PUBLIC_APP_NAME="Mazhi Sheti"
NEXT_PUBLIC_APP_URL="https://mazhisheti.in"
NODE_ENV="production"

# Database (Neon Serverless PostgreSQL with SSL)
DATABASE_URL="postgresql://mazhi_owner:secret_password@ep-green-farm-123456.ap-southeast-1.aws.neon.tech/mazhi_sheti?sslmode=require"

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_live_your_clerk_secret_key_here"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard/farmer"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding/farmer"

# Google Gemini / AI Assistant Service (Server-side Only)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
AI_ASSISTANT_API_KEY="sk_live_mazhi_sheti_ai_key"

# Payment Gateway (Razorpay Agri-Escrow)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="whsec_your_razorpay_webhook_secret"

# Error Tracking & Monitoring (Sentry & Better Stack)
NEXT_PUBLIC_SENTRY_DSN="https://your_sentry_dsn_key@o123456.ingest.sentry.io/7891011"
BETTER_STACK_TOKEN="your_better_stack_uptime_heartbeat_token"

# File Storage & Document Uploads (AWS S3 / Cloudflare R2 / UploadThing)
UPLOADTHING_SECRET="sk_live_uploadthing_secret"
UPLOADTHING_APP_ID="your_uploadthing_app_id"
NEXT_PUBLIC_STORAGE_BUCKET_URL="https://storage.mazhisheti.in"

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
HMAC_ESCROW_SECRET="your_cryptographic_hmac_secret_for_payment_validation"

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyCa_82GSgniz6U2D-pEtYrV850KgVHVSkE"
